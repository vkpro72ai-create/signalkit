# SignalKit — Production environment template
#
# Copy to .env.production and fill in all REQUIRED values before deploying.
# Never commit .env.production to git.
#
# Generate safe random secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# or:
#   openssl rand -hex 32
#
# ── Domains ───────────────────────────────────────────────────────────────────

# Public domain for the Next.js web app (used by Caddy)
WEB_DOMAIN=app.example.com

# Public domain for the NestJS API (used by Caddy)
API_DOMAIN=api.example.com

# ── Next.js public vars ───────────────────────────────────────────────────────

# URL that the browser uses to call the API.
# Must be the public HTTPS API URL (no trailing slash).
# REQUIRED
NEXT_PUBLIC_API_URL=https://api.example.com

NEXT_PUBLIC_DEFAULT_LOCALE=en

# ── Caddy ─────────────────────────────────────────────────────────────────────

# Email for Let's Encrypt TLS certificate registration.
# REQUIRED (otherwise Caddy uses a placeholder)
CADDY_ACME_EMAIL=ops@example.com

# ── Database (Supabase / PostgreSQL) ─────────────────────────────────────────
#
# Supabase provides two URLs:
#   DATABASE_URL  — pooled connection (PgBouncer, port 6543)
#   DIRECT_URL    — direct connection (port 5432, required for migrations)
#
# REQUIRED
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Redis ─────────────────────────────────────────────────────────────────────
#
# Redis is REQUIRED in production. BullMQ uses it for export + ingestion queues.
# In docker-compose.production.yml, the service builds REDIS_URL automatically
# from REDIS_PASSWORD. Set a strong random password here.
# REQUIRED
REDIS_PASSWORD=change-me-to-a-random-password

# ── Auth secrets ──────────────────────────────────────────────────────────────
#
# JWT_SECRET: sign JSON Web Tokens. Must be ≥ 32 characters. NEVER reuse across envs.
# REQUIRED
JWT_SECRET=GENERATE_WITH_openssl_rand_hex_32

# Token lifetime. Default: 7d. Reduce for higher-security deployments.
JWT_EXPIRES_IN=7d

# ── Encryption ────────────────────────────────────────────────────────────────
#
# AES-256-GCM key for encrypting BYOK LLM API keys at rest.
# Must be exactly 64 hex chars (32 bytes).
# REQUIRED
ENCRYPTION_KEY_FOR_LLM_KEYS=GENERATE_WITH_openssl_rand_hex_32

# ── CORS ─────────────────────────────────────────────────────────────────────
#
# Comma-separated list of allowed origins for the API.
# Must include your web domain (https). Never use * in production.
# REQUIRED
CORS_ORIGINS=https://app.example.com

# ── Export storage ────────────────────────────────────────────────────────────
#
# Path inside the API container where export files are written.
# Mapped to the exports_data Docker volume in docker-compose.production.yml.
# Default matches Dockerfile ENV. Change only if you mount elsewhere.
EXPORT_STORAGE_PATH=/var/lib/signalkit/exports

# How many days to retain ready export artifacts before marking them expired.
# Cleanup runs every hour. Default: 7
EXPORT_RETENTION_DAYS=7

# ── Optional: platform-level LLM keys ────────────────────────────────────────
#
# Only needed if you run SignalKit in platform mode (shared API keys).
# Normal operation uses BYOK (workspace-level encrypted keys).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=
