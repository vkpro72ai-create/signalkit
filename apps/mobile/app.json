{
  "expo": {
    "name": "SignalKit",
    "slug": "signalkit",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "signalkit",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FBFCFD"
    },
    "android": {
      "package": "com.signalkit.app"
    },
    "ios": {
      "bundleIdentifier": "com.signalkit.app",
      "supportsTablet": true
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
