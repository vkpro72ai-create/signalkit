{
  "name": "@signalkit/mobile",
  "version": "0.2.0",
  "private": true,
  "description": "SignalKit premium mobile app — Expo React Native.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:prod": "eas build --platform android --profile production",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:ios:prod": "eas build --platform ios --profile production",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "apk:debug": "node scripts/apk-debug.js",
    "prebuild:android": "expo prebuild --platform android"
  },
  "dependencies": {
    "@babel/runtime": "7.29.7",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@signalkit/i18n": "workspace:*",
    "@signalkit/shared": "workspace:*",
    "@signalkit/ui": "workspace:*",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-blur": "~14.0.3",
    "expo-constants": "~17.0.8",
    "expo-haptics": "~14.0.1",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.7",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.12"
  }
}
