# SignalKit Mobile — environment variables
# Copy to .env and fill in values. Never commit .env with real secrets.

# Required: Backend API base URL (no trailing slash)
# Local dev: http://localhost:3000
# Production: https://api.yourdomain.com
EXPO_PUBLIC_API_URL=http://localhost:3000

# Optional: Default locale for the app
EXPO_PUBLIC_DEFAULT_LOCALE=en

# Dev only: set to 'true' to use mock billing (always Pro entitlements)
# NEVER set to 'true' in production builds
EXPO_PUBLIC_MOCK_BILLING=false

# EAS project ID (from Expo dashboard — expo.dev)
EAS_PROJECT_ID=REPLACE_WITH_EAS_PROJECT_ID
