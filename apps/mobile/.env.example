# SignalKit Mobile — environment variables
# Copy to .env.local and fill in values. Never commit .env.local with real values.
#
# IMPORTANT: apk-debug.js auto-detects your machine LAN IP and writes
# .env.local automatically. You only need to set these manually if the
# auto-detection fails or you are targeting a specific environment.

# Required: Backend API base URL (no trailing slash)
#
#   API server runs on port 4000 (not 3000!).
#
#   Android emulator default:
#     EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
#
#   Physical Android device (replace with your machine LAN IP):
#     EXPO_PUBLIC_API_URL=http://192.168.1.x:4000
#
#   Production:
#     EXPO_PUBLIC_API_URL=https://api.signalkit.app
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# Environment: development | preview | production
EXPO_PUBLIC_ENV=development

# Optional: Default locale for the app
EXPO_PUBLIC_DEFAULT_LOCALE=en

# Dev only: set to 'true' to use mock billing (always Pro entitlements)
# NEVER set to 'true' in production builds
EXPO_PUBLIC_MOCK_BILLING=false

# EAS project ID (from Expo dashboard — expo.dev)
EAS_PROJECT_ID=REPLACE_WITH_EAS_PROJECT_ID

# Auto-written by apk-debug.js — do not set manually:
# EXPO_PUBLIC_GIT_COMMIT=<short-hash>
# EXPO_PUBLIC_BUILD_TIMESTAMP=<ISO-timestamp>
