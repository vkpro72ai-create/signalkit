# SignalKit API — copy to .env and fill in. Never commit real secrets.
NODE_ENV=development
PORT=4000

# Core infra (required in production)
DATABASE_URL=postgresql://signalkit:signalkit@localhost:5432/signalkit
REDIS_URL=redis://localhost:6379

# Auth & encryption (required in production)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY_FOR_LLM_KEYS=change-me-32-byte-key

# CORS — comma-separated origins, or * for all (dev only)
CORS_ORIGINS=http://localhost:3000

# Storage (S3-compatible / MinIO)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Optional provider keys (BYOK is the default; these are only for platform mode)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
