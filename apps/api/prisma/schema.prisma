model LLMProvider {
  id          String   @id @default(cuid())
  type        String   @unique
  displayName String
  baseUrl     String?
  docsUrl     String?
  hasAdapter  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LLMModel {
  id                   String   @id @default(cuid())
  provider             String
  modelId              String
  displayName          String
  contextWindow        Int      @default(0)
  maxOutputTokens      Int      @default(0)
  inputTokenPrice      Float    @default(0)
  outputTokenPrice     Float    @default(0)
  currency             String   @default("USD")
  pricingSource        String?
  pricingFetchedAt     DateTime?
  ratingOverall        Float?
  ratingReasoning      Float?
  ratingResearch       Float?
  ratingDocumentWriting Float?
  ratingCodingContext  Float?
  ratingMultilingual   Float?
  speedRating          Float?
  privacyRating        Float?
  strengths            String[] @default([])
  weaknesses           String[] @default([])
  bestUseCases         String[] @default([])
  supportedLanguages   String[] @default([])
  supportsJsonMode     Boolean  @default(false)
  supportsTools        Boolean  @default(false)
  supportsVision       Boolean  @default(false)
  supportsReasoning    Boolean  @default(false)
  sourceUrl            String?
  lastBenchmarkedAt    DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([provider, modelId])
}

model UserLLMConnection {
  id            String              @id @default(cuid())
  workspaceId   String
  userId        String?
  provider      String
  label         String
  // Encrypted at rest. NEVER returned to clients — services expose maskedKey only.
  encryptedKey  String
  maskedKey     String
  baseUrl       String?
  status        LlmConnectionStatus @default(active)
  lastTestedAt  DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id])

  @@index([workspaceId])
}

model WorkspaceLLMSettings {
  id             String  @id @default(cuid())
  workspaceId    String  @unique
  mode           LlmMode @default(byok)
  defaultModelId String?
  fallbackModelId String?
  routingRules   Json    @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model LLMUsageLog {
  id            String   @id @default(cuid())
  workspaceId   String
  userId        String?
  projectId     String?
  packId        String?
  documentId    String?
  provider      String
  model         String
  taskType      String
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  estimatedCost Float    @default(0)
  actualCost    Float?
  latencyMs     Int      @default(0)
  status        String   @default("success")
  errorCode     String?
  createdAt     DateTime @default(now())

  @@index([workspaceId, createdAt])
}

