// SignalKit production data model.
//
// This is the first real migration — the full domain, not a simplified MVP base.
// It is a faithful projection of @signalkit/shared. Identity / geo / settings /
// RBAC / audit (Session 2) are fully fleshed out; sources, niches, evidence,
// documents, LLM, exports and commercial tables exist so the database already
// supports language, geo, LLM, evidence and exports from day one (their feature
// modules arrive in later sessions).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum WorkspaceRole {
  owner
  admin
  strategist
  product_manager
  designer
  engineer
  growth
  viewer
  client_viewer
}

enum MemberStatus {
  active
  invited
  suspended
}

enum GeoConsentStatus {
  unknown
  granted
  denied
  revoked
}

enum LocationUsageMode {
  off
  country_only
  region_only
}

enum MarketScope {
  current_location
  country_of_residence
  manual_country
  manual_region
  multi_country
  global
}

enum RegulatorySensitivity {
  low
  medium
  high
}

enum LlmMode {
  byok
  platform
}

enum PlanType {
  free
  founder_pro
  agency
  studio
  enterprise
}

enum ProjectStatus {
  draft
  active
  archived
}

enum DocumentStatus {
  empty
  generating
  draft
  in_review
  changes_requested
  approved
  locked
  archived
  failed
}

enum ExportStatus {
  queued
  processing
  ready
  failed
  expired
}

enum PackGenerationJobStatus {
  queued
  running
  partially_ready
  completed
  failed
  cancelled
}

enum PackGenerationStepStatus {
  pending
  running
  completed
  repairing
  failed
  skipped
}

enum PackGenerationMode {
  standard
  strong_model
}

// Founder's personal decision on an opportunity (separate from AI scoring).
// Prisma enum (not a free string) so a typo can never reach the DB.
enum FounderDecision {
  undecided
  explore
  generate_pack
  postpone
  reject
  ready_to_commit
}

// Founder-selected ambition for a promoted implementation project. Ambition
// is a founder framing choice — it never gates buildReady.
enum AmbitionMode {
  cash_flow_business
  venture_scale
  unicorn_ambition
}

enum RiskLevel {
  low
  medium
  high
}

enum SourceItemStatus {
  collected
  parsed
  failed
  excluded
}

enum LlmConnectionStatus {
  active
  invalid
  revoked
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity & platform
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String?
  displayName     String?
  avatarUrl       String?
  emailVerified   Boolean  @default(false)
  interfaceLocale String   @default("en")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  settings        UserSettings?
  memberships     WorkspaceMember[]
  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  auditEvents     AuditLog[]        @relation("AuditActor")
  createdProjects Project[]         @relation("ProjectCreator")
  llmConnections  UserLLMConnection[]
  founderVerdicts OpportunityFounderVerdict[]
  committedProjects ImplementationProject[] @relation("ImplementationProjectCreator")
  mcpClientSessions      McpClientSession[]
  mcpAuthorizationCodes  McpAuthorizationCode[]
  mcpRefreshTokens       McpRefreshToken[]
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner            User               @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members          WorkspaceMember[]
  settings         WorkspaceSettings?
  llmSettings      WorkspaceLLMSettings?
  projects         Project[]
  auditEvents      AuditLog[]
  llmConnections   UserLLMConnection[]
  billingAccount   BillingAccount?
  apiKeys          APIKey[]
  mcpClientSessions      McpClientSession[]
  mcpAuthorizationCodes  McpAuthorizationCode[]
  mcpRefreshTokens       McpRefreshToken[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(viewer)
  status      MemberStatus  @default(active)
  invitedById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model UserSettings {
  id                      String            @id @default(cuid())
  userId                  String            @unique
  interfaceLocale         String            @default("en")
  defaultDocumentLanguage String            @default("en")
  fallbackLanguage        String            @default("en")
  timezone                String            @default("UTC")
  // Geo (consent-gated; never precise coordinates)
  geoConsentStatus        GeoConsentStatus  @default(unknown)
  locationUsageMode       LocationUsageMode @default(off)
  detectedCountry         String?
  detectedRegion          String?
  countryOfResidence      String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkspaceSettings {
  id                  String   @id @default(cuid())
  workspaceId         String   @unique
  defaultLocale       String   @default("en")
  defaultMarketCountry String?
  defaultMarketRegion String?
  defaultLlmMode      LlmMode  @default(byok)
  billingPlan         PlanType @default(free)
  // White-label (real schema now; full feature in Session 17)
  whiteLabelEnabled   Boolean  @default(false)
  brandName           String?
  logoUrl             String?
  accentTokenName     String?
  footerText          String?
  customDisclaimer    String?
  hideSignalKitBrand  Boolean  @default(false)
  clientName          String?
  preparedBy          String?
  agencyContact       String?
  // Display name for the AI engine on customer-facing surfaces (dashboard,
  // side panels) instead of the raw provider/model id. Null falls back to
  // a translated default ("SignalKit AI") chosen in application code.
  aiEngineName        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  action      String
  actorId     String?
  subjectType String
  subjectId   String?
  metadata    Json     @default("{}")
  ipAddress   String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation("AuditActor", fields: [actorId], references: [id])

  @@index([workspaceId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Geo / market reference
// ─────────────────────────────────────────────────────────────────────────────

model Country {
  code            String  @id // ISO 3166-1 alpha-2
  names           Json    @default("{}") // localized names keyed by locale
  primaryLanguage String  @default("en")
  currency        String  @default("USD")

  regions Region[]
}

model Region {
  code        String @id // ISO 3166-2 / internal
  countryCode String
  names       Json   @default("{}")

  country Country @relation(fields: [countryCode], references: [code], onDelete: Cascade)

  @@index([countryCode])
}

// ─────────────────────────────────────────────────────────────────────────────
// Projects & search context
// ─────────────────────────────────────────────────────────────────────────────

/// DEPRECATED name: this model is a Research / Opportunity-Search context
/// (market scope + discovery goal + its opportunities), NOT an implementation
/// project. Real, founder-committed projects live in `ImplementationProject`.
/// Kept under this name for backward compatibility — do not repurpose its rows.
model Project {
  id                  String        @id @default(cuid())
  workspaceId         String
  name                String
  goal                String        @default("")
  status              ProjectStatus @default(draft)
  // Market profile (denormalized onto the project)
  marketScope         MarketScope   @default(global)
  targetCountry       String?
  targetRegion        String?
  targetCountries     String[]      @default([])
  targetRegions       String[]      @default([])
  marketLanguage      String        @default("en")
  regulatorySensitivity RegulatorySensitivity @default(medium)
  defaultOutputLanguage String      @default("en")
  createdById         String
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy      User            @relation("ProjectCreator", fields: [createdById], references: [id])
  searchContexts SearchContext[]
  sourceRefs     SourceReference[]
  signals        TrendSignal[]
  niches         Niche[]
  implementationProjects ImplementationProject[] @relation("ResearchProject")

  @@index([workspaceId])
}

model SearchContext {
  id              String   @id @default(cuid())
  workspaceId     String
  projectId       String
  version         Int      @default(1)
  industry        String?
  theme           String?
  audience        String?
  productFormat   String?
  marketScope     MarketScope @default(global)
  targetCountry   String?
  targetRegion    String?
  targetCountries String[] @default([])
  targetRegions   String[] @default([])
  marketLanguage  String   @default("en")
  outputLanguage  String   @default("en")
  languageMode    String   @default("follow_interface")
  localContextRules String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Sources & signals  (feature module: Session 7)
// ─────────────────────────────────────────────────────────────────────────────

model SourceReference {
  id           String   @id @default(cuid())
  workspaceId  String
  projectId    String
  adapter      String
  url          String?
  title        String?
  publisher    String?
  language     String?
  country      String?
  userProvided Boolean  @default(false)
  collectedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rawItems      RawSourceItem[]
  evidenceItems EvidenceItem[]

  @@index([projectId])
}

model RawSourceItem {
  id          String           @id @default(cuid())
  workspaceId String
  projectId   String
  sourceRefId String
  adapter     String
  content     String
  url         String?
  language    String?
  country     String?
  status      SourceItemStatus @default(collected)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  sourceRef       SourceReference     @relation(fields: [sourceRefId], references: [id], onDelete: Cascade)
  normalizedItems NormalizedSourceItem[]

  @@index([sourceRefId])
}

model NormalizedSourceItem {
  id               String   @id @default(cuid())
  rawSourceItemId  String
  summary          String
  extractedEntities String[] @default([])
  detectedMarket   String?
  detectedLanguage String?
  relevance        Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  rawItem RawSourceItem @relation(fields: [rawSourceItemId], references: [id], onDelete: Cascade)

  @@index([rawSourceItemId])
}

model TrendSignal {
  id            String   @id @default(cuid())
  workspaceId   String
  projectId     String
  signalType    String
  text          String
  strengthScore Float    @default(0)
  freshnessScore Float   @default(0)
  sourceQuality Float    @default(0)
  industry      String?
  topic         String?
  audience      String?
  sourceRefIds  String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Niches & scoring  (feature module: Session 9)
// ─────────────────────────────────────────────────────────────────────────────

model Niche {
  id                       String    @id @default(cuid())
  workspaceId              String
  projectId                String
  title                    String
  oneLiner                 String    @default("")
  problem                  String    @default("")
  targetAudience           String    @default("")
  whyNow                   String    @default("")
  useCases                 String[]  @default([])
  competitors              String[]  @default([])
  mvpConcept               String    @default("")
  monetization             String    @default("")
  recommendedProductFormat String    @default("")
  riskLevel                RiskLevel @default(medium)
  language                 String    @default("en")
  // 'discovered' (default, via discover()) | 'founder_idea' (via createFromIdea()).
  intakeMode               String    @default("discovered")
  // Verbatim founder-supplied idea text when intakeMode is 'founder_idea'; kept
  // separate from the LLM-derived oneLiner/problem so Pack generation can use
  // the founder's own words as founderRequest.
  founderIdeaText          String    @default("")
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scores         NicheScore[]
  claims         Claim[]
  packs          ProductDocumentPack[]
  ventureTheses  VentureThesis[]
  founderVerdicts        OpportunityFounderVerdict[]
  implementationProjects ImplementationProject[]

  @@index([projectId])
}

model ScoringVersion {
  id          String   @id @default(cuid())
  version     String   @unique
  description String   @default("")
  createdAt   DateTime @default(now())

  scores NicheScore[]
}

model NicheScore {
  id               String   @id @default(cuid())
  nicheId          String
  scoringVersionId String
  totalScore       Float    @default(0)
  confidenceValue  Float    @default(0)
  confidenceLevel  String   @default("low")
  breakdown        Json     @default("[]")
  riskPenalties    Json     @default("[]")
  explanation      String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  niche          Niche          @relation(fields: [nicheId], references: [id], onDelete: Cascade)
  scoringVersion ScoringVersion @relation(fields: [scoringVersionId], references: [id])

  @@index([nicheId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Breakout Opportunity Engine — Venture Thesis + Venture Scale Score
// (feature module: Session 14). Additive, backwards-compatible.
// ─────────────────────────────────────────────────────────────────────────────

model VentureThesis {
  id                      String   @id @default(cuid())
  workspaceId             String
  nicheId                 String
  projectId               String
  // Full structured VentureThesis contract (shared type).
  thesis                  Json     @default("{}")
  // Venture Scale Score — SEPARATE from opportunity & confidence.
  ventureScaleScore       Float    @default(0)
  ventureScaleConfidence  Float    @default(0)
  ventureScaleLevel       String   @default("low")
  ventureScaleBreakdown   Json     @default("[]")
  whatMustBeTrue          Json     @default("[]")
  version                 Int      @default(1)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  niche Niche @relation(fields: [nicheId], references: [id], onDelete: Cascade)

  @@index([nicheId])
  @@index([projectId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Human decision layer — founder verdict + promoted implementation projects
// (additive, backwards-compatible). Kept SEPARATE from AI scoring: a high AI
// score never auto-promotes.
// ─────────────────────────────────────────────────────────────────────────────

/// A founder's personal, per-user verdict on an opportunity (Niche). One row
/// per (niche, user) so multi-founder workspaces each keep their own rating;
/// promotion uses the committing founder's own verdict.
model OpportunityFounderVerdict {
  id          String          @id @default(cuid())
  workspaceId String
  nicheId     String
  userId      String
  rating      Int?            // 1–5 personal rating (nullable = not yet rated)
  comment     String          @default("")
  decision    FounderDecision @default(undecided)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  niche Niche @relation(fields: [nicheId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([nicheId, userId])
  @@index([nicheId])
  @@index([workspaceId])
}

/// A real, founder-committed implementation project. Created ONLY via the
/// explicit promotion gate (Build-Ready pack + founder commitment) — never
/// automatically. Snapshots the decision inputs at commitment time.
model ImplementationProject {
  id                     String       @id @default(cuid())
  workspaceId            String
  researchProjectId      String       // the source Research/Search-context Project
  nicheId                String       // the promoted opportunity
  packId                 String       // the selected Build-Ready Product Pack
  founderRatingSnapshot  Int?
  founderCommentSnapshot String       @default("")
  ambitionMode           AmbitionMode
  buildReadySnapshot     Boolean      @default(false)
  ventureReadySnapshot   Boolean      @default(false)
  unicornPotentialSnapshot Boolean    @default(false)
  // Top risks / kill-reasons frozen from the VentureThesis at promotion time.
  topRisksSnapshot       Json         @default("[]")
  committedAt            DateTime     @default(now())
  status                 String       @default("active") // active | paused | archived
  createdById            String
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  researchProject Project             @relation("ResearchProject", fields: [researchProjectId], references: [id], onDelete: Cascade)
  niche           Niche               @relation(fields: [nicheId], references: [id], onDelete: Cascade)
  pack            ProductDocumentPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  createdBy       User                @relation("ImplementationProjectCreator", fields: [createdById], references: [id])

  @@unique([packId]) // one implementation project per pack — re-promotion returns the existing one
  @@index([workspaceId])
  @@index([nicheId])
  @@index([researchProjectId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Evidence graph  (feature module: Session 8)
// ─────────────────────────────────────────────────────────────────────────────

model EvidenceItem {
  id               String   @id @default(cuid())
  workspaceId      String
  projectId        String?
  sourceRefId      String
  evidenceType     String
  originalText     String
  sourceLanguage   String?
  summary          String
  summaryLanguage  String   @default("en")
  country          String?
  region           String?
  relevanceScore   Float    @default(0)
  freshnessScore   Float    @default(0)
  sourceQuality    Float    @default(0)
  extractionMethod String   @default("manual")
  extractedAt      DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sourceRef SourceReference     @relation(fields: [sourceRefId], references: [id], onDelete: Cascade)
  links     ClaimEvidenceLink[]

  @@index([sourceRefId])
  @@index([projectId])
}

model Claim {
  id              String   @id @default(cuid())
  workspaceId     String
  projectId       String?
  nicheId         String?
  text            String
  type            String
  confidenceValue Float    @default(0)
  confidenceLevel String   @default("low")
  market          String?
  language        String   @default("en")
  generatedBy     String   @default("llm")
  reviewStatus    String   @default("unreviewed")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  niche          Niche?              @relation(fields: [nicheId], references: [id])
  evidenceLinks  ClaimEvidenceLink[]
  contradictions Contradiction[]

  @@index([nicheId])
  @@index([projectId])
}

model ClaimEvidenceLink {
  id             String @id @default(cuid())
  claimId        String
  evidenceItemId String
  role           String @default("supports")
  weight         Float  @default(1)

  claim    Claim        @relation(fields: [claimId], references: [id], onDelete: Cascade)
  evidence EvidenceItem @relation(fields: [evidenceItemId], references: [id], onDelete: Cascade)

  @@unique([claimId, evidenceItemId])
}

model Contradiction {
  id                   String   @id @default(cuid())
  claimId              String
  conflictingEvidenceIds String[] @default([])
  reason               String
  suggestedQuestion    String?
  resolved             Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
}

model Assumption {
  id               String   @id @default(cuid())
  workspaceId      String
  projectId        String?
  claimId          String?
  text             String
  language         String   @default("en")
  rationale        String   @default("")
  validationStatus String   @default("untested")
  impactIfWrong    String   @default("medium")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([projectId])
  @@index([claimId])
}

model Constraint {
  id          String   @id @default(cuid())
  workspaceId String?
  projectId   String?
  text        String
  category    String   @default("technical")
  language    String   @default("en")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

model UnresolvedQuestion {
  id          String   @id @default(cuid())
  workspaceId String?
  projectId   String?
  claimId     String?
  text        String
  language    String   @default("en")
  priority    String   @default("medium")
  status      String   @default("open")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([claimId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Product Document Pack  (feature module: Session 10)
// ─────────────────────────────────────────────────────────────────────────────

model ProductDocumentPack {
  id              String         @id @default(cuid())
  workspaceId     String
  nicheId         String
  projectId       String
  title           String
  depth           String
  verticalTemplate String
  primaryLanguage String         @default("en")
  status          DocumentStatus @default(draft)
  confidenceValue Float          @default(0)
  confidenceLevel String         @default("low")
  version         Int            @default(1)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  niche     Niche                 @relation(fields: [nicheId], references: [id], onDelete: Cascade)
  documents ProductPackDocument[]
  implementationProject ImplementationProject?

  @@index([nicheId])
}

model ProductPackDocument {
  id                String         @id @default(cuid())
  packId            String
  docType           String
  title             String
  body              String         @default("")
  language          String         @default("en")
  status            DocumentStatus @default(draft)
  confidenceValue   Float          @default(0)
  confidenceLevel   String         @default("low")
  qualityGateStatus String         @default("not_run")
  // Per-document metadata contract: market, packDepth, verticalTemplate,
  // sourceRefIds, claimIds, assumptionIds, constraintIds, unresolvedQuestionIds.
  metadata          Json           @default("{}")
  version           Int            @default(1)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  pack     ProductDocumentPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  versions DocumentVersion[]

  @@index([packId])
}

model QualityGateResult {
  id          String   @id @default(cuid())
  packId      String
  status      String   @default("not_run")
  checks      Json     @default("[]")
  passedCount Int      @default(0)
  warnCount   Int      @default(0)
  failCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([packId])
}

// Async, job-based Product Pack v2 generation (Task 3): the API returns a
// job+pack id immediately instead of blocking on the ~20-25min multi-step
// LLM pipeline. ProductPackGenerationStep tracks per-step progress/timing so
// the client can poll for staged availability instead of a bare spinner.
model ProductPackGenerationJob {
  id                         String                  @id @default(cuid())
  workspaceId                String
  projectId                  String
  nicheId                    String
  packId                     String
  status                     PackGenerationJobStatus @default(queued)
  generationMode             PackGenerationMode      @default(standard)
  depth                      String
  verticalTemplate           String
  language                   String?
  requestedById              String?
  currentStep                String?
  progressPercent            Int                     @default(0)
  readyDocumentCount         Int                     @default(0)
  totalExpectedDocumentCount Int                     @default(0)
  buildReady                 Boolean                 @default(false)
  errorCode                  String?
  errorReason                String?
  startedAt                  DateTime?
  completedAt                DateTime?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  // Free-form extras: durationsMsByStep summary, repair totals, etc.
  metadata                   Json                    @default("{}")

  steps ProductPackGenerationStep[]

  @@index([workspaceId])
  @@index([packId])
  @@index([nicheId])
}

model ProductPackGenerationStep {
  id              String                    @id @default(cuid())
  jobId           String
  stepKey         String
  status          PackGenerationStepStatus  @default(pending)
  provider        String?
  model           String?
  maxOutputTokens Int?
  inputTokens     Int?
  outputTokens    Int?
  startedAt       DateTime?
  completedAt     DateTime?
  durationMs      Int?
  attemptCount    Int                       @default(0)
  repairCount     Int                       @default(0)
  errorCode       String?
  errorReason     String?
  documentIds     Json                      @default("[]")
  metadata        Json                      @default("{}")
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  job ProductPackGenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, stepKey])
  @@index([jobId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Build Blueprint Layer (feature module: Session 14). Additive.
// One blueprint per pack: screen contracts, state matrix, API↔screen map,
// component contracts, permission matrix, analytics events, DO_NOT_BUILD.
// ─────────────────────────────────────────────────────────────────────────────

model BuildBlueprint {
  id                       String   @id @default(cuid())
  workspaceId              String
  packId                   String
  nicheId                  String
  projectId                String
  screenContracts          Json     @default("[]")
  stateMatrix              Json     @default("[]")
  apiToScreenMap           Json     @default("[]")
  componentContracts       Json     @default("[]")
  permissionMatrix         Json     @default("[]")
  analyticsEvents          Json     @default("[]")
  doNotBuild               Json     @default("[]")
  validationRules          Json     @default("[]")
  // Build Readiness Score — SEPARATE from opportunity/confidence/venture scale.
  buildReadinessScore      Float    @default(0)
  buildReadinessLevel      String   @default("low")
  buildReadinessBreakdown  Json     @default("[]")
  warnings                 Json     @default("[]")
  version                  Int      @default(1)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([packId])
  @@index([nicheId])
}

model DocumentVersion {
  id                     String   @id @default(cuid())
  documentId             String
  packId                 String?
  workspaceId            String?
  version                Int
  body                   String
  changeSummary          String   @default("")
  authorId               String?
  generatedBy            String   @default("human")
  // Provenance of an AI-generated version (null for human edits) — surfaced by
  // the "why this changed" decision-history UI.
  provider               String?
  model                  String?
  linkedResearchUpdateId String?
  affectedClaimIds       Json     @default("[]")
  affectedAssumptionIds  Json     @default("[]")
  createdAt              DateTime @default(now())

  document ProductPackDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([packId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Document Governance  (feature module: Session 11)
// ─────────────────────────────────────────────────────────────────────────────

model ResearchUpdate {
  id                  String   @id @default(cuid())
  packId              String
  workspaceId         String
  projectId           String?
  title               String
  type                String   @default("internal_team_note")
  content             String   @default("")
  language            String   @default("en")
  marketContext       String?
  sourceRefs          Json     @default("[]")
  linkedDocumentIds   Json     @default("[]")
  linkedClaimIds      Json     @default("[]")
  linkedAssumptionIds Json     @default("[]")
  linkedQuestionIds   Json     @default("[]")
  confidenceImpact    String?
  createdById         String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([packId])
  @@index([workspaceId])
}

model DocumentComment {
  id            String    @id @default(cuid())
  workspaceId   String
  projectId     String?
  packId        String
  documentId    String?
  claimId       String?
  assumptionId  String?
  // Which document section (by its `### heading` text) this comment is
  // about. Null = whole-document comment (pre-existing behavior).
  sectionHeading String?
  authorId      String
  body          String
  status        String    @default("open")
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?
  resolvedBy    String?

  @@index([packId])
  @@index([documentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// LLM marketplace  (feature module: Session 4-5)
