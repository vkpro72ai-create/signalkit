# SignalKit API — production env template
#
# These vars are passed via docker-compose.production.yml environment block.
# You do NOT need a separate .env.production file for the API container —
# docker-compose reads from the root .env.production (or --env-file flag).
#
# This file documents what the API expects in production.
#
# REQUIRED values must be set. Missing required secrets prevent API startup.

NODE_ENV=production
PORT=4000

# ── Database ──────────────────────────────────────────────────────────────────
# Supabase pooled URL (for runtime queries via PgBouncer)
DATABASE_URL=postgresql://postgres.REF:PASS@aws-0-REGION.pooler.supabase.com:6543/postgres
# Supabase direct URL (for prisma migrate deploy — bypasses PgBouncer)
DIRECT_URL=postgresql://postgres.REF:PASS@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Redis ─────────────────────────────────────────────────────────────────────
# In compose, this is built as: redis://:${REDIS_PASSWORD}@redis:6379
REDIS_URL=redis://:REDIS_PASSWORD@redis:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=REQUIRED_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d

# ── Encryption ────────────────────────────────────────────────────────────────
ENCRYPTION_KEY_FOR_LLM_KEYS=REQUIRED_64_HEX_CHARS_32_BYTES

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://app.example.com

# ── Export storage ────────────────────────────────────────────────────────────
EXPORT_STORAGE_PATH=/var/lib/signalkit/exports
EXPORT_RETENTION_DAYS=7
