# SignalKit Web — production env template
#
# NEXT_PUBLIC_* vars are baked into the client bundle at build time.
# They must NOT contain secrets — they are visible to anyone who loads the page.
#
# Set these as build args or environment variables before running `next build`.
# In docker-compose.production.yml they are passed via the environment block.

# Public API base URL — the URL the browser uses to call the API.
# Must be the public HTTPS URL. No trailing slash.
# REQUIRED
NEXT_PUBLIC_API_URL=https://api.example.com

# Default UI locale. One of: en, ru, tr, de, es, fr, pt, ar, hi, id
NEXT_PUBLIC_DEFAULT_LOCALE=en
