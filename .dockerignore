# Docker build context (see infra/docker/Dockerfile.api).
# Images are built from source inside the builder stage — never ship host
# node_modules, build output or local secrets into the context.

# VCS / editor tooling
.git
.github
.vscode
.idea
**/.DS_Store

# Dependencies and build output (rebuilt inside the image)
**/node_modules
.pnpm-store
**/dist
**/.next
**/.expo
**/.turbo
**/*.tsbuildinfo
**/coverage

# Secrets — env files are runtime configuration, never image content
**/.env
**/.env.*
!**/.env.example

# Not part of any server image
apps/mobile
docs
*.log
