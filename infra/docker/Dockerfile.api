FROM node:22-bookworm-slim

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV PORT=4000

RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@10.32.1 --activate

WORKDIR /app

COPY . .

RUN pnpm install --frozen-lockfile --prod=false \
 && DATABASE_URL=postgresql://placeholder:placeholder@localhost:5432/placeholder pnpm --filter @signalkit/api exec prisma generate \
 && pnpm exec tsc -b \

 && pnpm --filter @signalkit/api build

ENV NODE_ENV=production

EXPOSE 4000

CMD ["sh", "-c", "pnpm --filter @signalkit/api exec prisma migrate deploy && pnpm --filter @signalkit/api start"]
